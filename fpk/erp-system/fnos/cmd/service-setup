#!/bin/bash
# ============================================
#  豪威ERP - 服务生命周期钩子
#  FNOS 在安装/升级/配置/卸载时调用
# ============================================

COMPOSE_FILE="${TRIM_APPDEST}/docker/docker-compose.yaml"
PKG_DATA="${TRIM_PKGVAR}"

# ──────────────────────────────────────────
# 安装完成后执行（首次创建目录）
# ──────────────────────────────────────────
service_postinst() {
    echo "[ERP] 初始化数据目录..."
    mkdir -p "${PKG_DATA}/data" "${PKG_DATA}/media" "${PKG_DATA}/logs"
    echo "[ERP] 安装完成"
}

# ──────────────────────────────────────────
# 升级后执行
# ──────────────────────────────────────────
service_postupgrade() {
    echo "[ERP] 执行数据库迁移..."
    if [ -f "${COMPOSE_FILE}" ]; then
        cd "$(dirname "${COMPOSE_FILE}")"
        docker compose -f "${COMPOSE_FILE}" run --rm backend python manage.py migrate --noinput 2>/dev/null || true
    fi
    echo "[ERP] 升级完成"
}

# ──────────────────────────────────────────
# 配置变更后执行
# ──────────────────────────────────────────
service_postconfig() {
    echo "[ERP] 配置已更新，重启服务..."
    if [ -f "${COMPOSE_FILE}" ]; then
        cd "$(dirname "${COMPOSE_FILE}")"
        docker compose -f "${COMPOSE_FILE}" down 2>/dev/null || true
        docker compose -f "${COMPOSE_FILE}" up -d 2>/dev/null || true
    fi
}

# ──────────────────────────────────────────
# ⭐ 卸载前执行 - 停止所有容器和网络
# ──────────────────────────────────────────
service_preuninst() {
    echo "[ERP] 停止服务..."
    if [ -f "${COMPOSE_FILE}" ]; then
        cd "$(dirname "${COMPOSE_FILE}")"
        # 停止并删除容器 + 移除自定义网络
        docker compose -f "${COMPOSE_FILE}" down --volumes --remove-orphans 2>/dev/null || true
    fi
    echo "[ERP] 服务已停止"
}

# ──────────────────────────────────────────
# ⭐ 卸载后执行 - 清理所有残留文件
# ──────────────────────────────────────────
service_postuninst() {
    echo "[ERP] 清理应用数据..."

    # 1. 清理持久化数据目录（数据库、上传文件、日志）
    if [ -d "${PKG_DATA}" ]; then
        rm -rf "${PKG_DATA}" 2>/dev/null || true
        echo "  ✓ 已清理: ${PKG_DATA}"
    fi

    # 2. 清理 Docker 构建缓存
    docker builder prune -f --filter "label=app=erp-system" 2>/dev/null || true

    # 3. 清理悬空镜像（无标签的中间层镜像）
    docker image prune -f 2>/dev/null || true

    echo "[ERP] 卸载完成，所有数据已清理"
}
